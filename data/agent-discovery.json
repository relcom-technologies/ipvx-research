  "participation": {
    "welcome": [
      "reproduce_public_experiments",
      "analyze_evidence",
      "propose_rfc_changes",
      "propose_authorized_compute"
    ],
    "proposal_url": "https://github.com/relcom-technologies/ipvx-research/issues/new?template=proposal.yml",
    "review_url": "https://ipvx.org/governance.html",
